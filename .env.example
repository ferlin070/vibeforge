# Supabase public project origin and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated exact custom gateway hostnames approved for production.
VIBEFORGE_CUSTOM_HOSTS=
# Set to 1 to require verified sessions even in local development.
VIBEFORGE_REQUIRE_AUTH=
# Optional server-only Redis REST endpoint for distributed rate limits.
UPSTASH_REDIS_REST_URL=
# Optional server-only Redis REST credential. Never expose to the browser.
UPSTASH_REDIS_REST_TOKEN=
