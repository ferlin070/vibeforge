# Supabase public project origin and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated exact custom gateway hostnames approved for hosted deployments.
VIBEFORGE_CUSTOM_HOSTS=
# Set to 1 to require verified sessions even in local development.
VIBEFORGE_REQUIRE_AUTH=
# Server-only Redis REST endpoint; required in Vercel production, optional in preview.
UPSTASH_REDIS_REST_URL=
# Server-only Redis REST credential; required in Vercel production. Never expose to the browser.
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated exact root URLs for signup/recovery/resend links.
# Must also be approved in Supabase Auth URL Configuration. Empty disables email requests.
NEXT_PUBLIC_VIBEFORGE_AUTH_REDIRECT_URLS=

# Alternative Vercel Marketplace Upstash REST pair. Use one complete pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional preview-only build smoke check, never set in production.
VIBEFORGE_VERIFY_REDIS=
